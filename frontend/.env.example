# PharmaPulse front-end configuration.
# Copy to `.env.local` and fill in values for your deployment.
# NOTE: these are PUBLIC client-side values only (Cognito hosted-UI is a
# public OAuth client). Do NOT put any secret (client secret, API keys,
# passwords) in this file or anywhere in the front-end source.

# Base URL of the streaming backend that exposes POST /chat (SSE).
# Example: https://api.demo.awsteach.com
VITE_CHAT_API_URL=http://localhost:8000

# --- Cognito hosted UI (OAuth2 authorization-code / implicit flow) ---
# The Cognito hosted-UI domain, e.g. https://pharmapulse.auth.us-east-2.amazoncognito.com
VITE_COGNITO_DOMAIN=https://example.auth.us-east-2.amazoncognito.com

# The Cognito app client id (public).
VITE_COGNITO_CLIENT_ID=your-app-client-id

# Where Cognito redirects back to after login. Must be registered as an
# allowed callback URL on the app client.
VITE_COGNITO_REDIRECT_URI=http://localhost:5173

# Where Cognito redirects after logout. Must be a registered sign-out URL.
VITE_COGNITO_LOGOUT_URI=http://localhost:5173

# OAuth scopes requested at the authorize endpoint (space separated).
VITE_COGNITO_SCOPE=openid email profile
